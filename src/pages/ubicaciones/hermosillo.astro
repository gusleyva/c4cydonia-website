---
import MainLayout from "../../layouts/MainLayout.astro";

const seoTitle = "Desarrollo de Software en Hermosillo | C4Cydonia";
const seoDescription =
    "Servicios profesionales de desarrollo de software, consultoría tecnológica, desarrollo web y móvil en Hermosillo, Sonora. Expertos en soluciones digitales para empresas.";
const seoKeywords =
    "desarrollo software Hermosillo, consultoría tecnológica Hermosillo, desarrollo web Hermosillo, desarrollo móvil Hermosillo, programación Hermosillo, servicios tecnológicos Hermosillo, desarrollo aplicaciones Hermosillo";

const localBusinessData = {
    "@context": "https://schema.org",
    "@type": "LocalBusiness",
    name: "C4Cydonia - Hermosillo",
    description: seoDescription,
    areaServed: {
        "@type": "City",
        name: "Hermosillo",
        addressRegion: "Sonora",
        addressCountry: "MX",
    },
};
---

<MainLayout
    title={seoTitle}
    description={seoDescription}
    keywords={seoKeywords}
    structuredData={[localBusinessData]}
>
    <!-- Hero Section -->
    <section
        class="bg-gradient-to-r from-primary-800 to-primary-600 text-white py-20"
    >
        <div class="container mx-auto px-4">
            <div class="max-w-4xl mx-auto text-center">
                <h1 class="text-4xl md:text-5xl font-bold mb-6">
                    Desarrollo de Software en Hermosillo
                </h1>
                <p class="text-xl md:text-2xl mb-8">
                    Soluciones tecnológicas profesionales para empresas en la
                    capital de Sonora
                </p>
                <div class="flex flex-wrap justify-center gap-4">
                    <a
                        href="/contact"
                        class="btn bg-white text-primary-800 hover:bg-gray-100 font-bold py-3 px-8 rounded-md"
                    >
                        Solicitar Cotización
                    </a>
                    <a
                        href="/services"
                        class="btn bg-transparent border-2 border-white text-white hover:bg-white hover:text-primary-800 font-bold py-3 px-8 rounded-md"
                    >
                        Ver Servicios
                    </a>
                </div>
            </div>
        </div>
    </section>

    <!-- Why Choose Us in Hermosillo -->
    <section class="py-16 bg-white dark:bg-gray-900">
