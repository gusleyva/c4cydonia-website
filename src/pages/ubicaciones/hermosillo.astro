                                ></path>
                            </svg>
                        </div>
                        <div>
                            <h3 class="text-xl font-semibold mb-2">
                                Precios Competitivos
                            </h3>
                            <p class="text-gray-600 dark:text-gray-400">
                                Tarifas justas y transparentes adaptadas al
                                mercado local de Hermosillo.
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
